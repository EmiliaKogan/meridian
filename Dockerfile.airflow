ARG AIRFLOW_IMAGE=apache/airflow:3.3.2-python3.14
FROM ${AIRFLOW_IMAGE}

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        docker.io \
        docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

USER airflow

RUN pip install --no-cache-dir \
    "psycopg[binary]>=3.3.4" \
    "httpx>=0.28.1"








